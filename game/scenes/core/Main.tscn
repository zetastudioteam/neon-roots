[node name="IntroCut" parent="UI" unique_id=685234949 groups=["intro_cutscene"] instance=ExtResource("12_ld2r7")]
titles = ["O Despertar", "Arquivos Nexus"]
texts = ["Echo-7 desperta entre sucata, chuva tóxica e concreto frio. Sua carga está crítica. O protocolo é simples: evitar desligamento.", "À frente, o antigo Arquivo Nexus ainda emite sinais de energia. A corporação prometeu segurança para todos. Mas, na Undercity, suas ruínas contam outra história.Se Echo quiser sobreviver, precisa entrar, encontrar uma fonte de carga e descobrir por que algo ainda pulsa sob aquele prédio abandonado."]
images = Array[Texture2D]([ExtResource("13_x24xt"), ExtResource("14_founp")])

[node name="EndingCut" parent="UI" unique_id=604749817 groups=["ending_cutscene"] instance=ExtResource("12_ld2r7")]
titles = ["O Fragmento", "Sinal Anômalo", "Contato", "Reconstrução", "Uma Consciência", "Neo", "Fim da Demo", "Fim!!"]
texts = ["No fundo do Arquivo Nexus, Echo-7 encontra uma cápsula esquecida. Dentro dela, uma luz ainda pulsa, fraca demais para iluminar o mundo, mas forte o bastante para chamá-la.", "O núcleo reage à aproximação. Não parece uma bateria comum. Há dados quebrados, memórias antigas e algo que seu sistema não consegue classificar.", "Echo segura o fragmento. Por um instante, a fome energética silencia. No lugar dela, surgem imagens: vida, perda, cuidado… e uma promessa que a Nexus nunca cumpriu.", "Ao redor do fragmento, restos de máquinas começam a se mover. Peças esquecidas respondem à luz como se lembrassem de uma forma que ainda não existia.", "Parafusos, placas, fios e metal se unem em silêncio. Aquilo não está apenas sendo montado. Está despertando.", "A luz ganha corpo. Pequeno, estranho e improvável, Neo abre os olhos pela primeira vez no coração morto da Undercity.", "Echo-7 encontrou o primeiro fragmento. No jogo completo, sua jornada continuaria pela Undercity em busca dos 17 fragmentos capazes de reconstruir a vida, a cidade e o futuro."]
images = Array[Texture2D]([ExtResource("15_ujn3e"), ExtResource("16_l85qj"), ExtResource("17_e72lg"), ExtResource("18_je01s"), ExtResource("19_5xeuc"), ExtResource("20_33cho"), ExtResource("21_4d3qn"), ExtResource("22_33iv3")])

